# =============================================================================
# SkillAgents 仓库根级 .gitignore
# 单独项目里(如 examples/hello-agent/)也有自己的 .gitignore,做局部补充
# =============================================================================

# --- 环境变量(含密钥/内网地址) ---
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- 运行时产物(Agent 示例) ---
# hello-agent 会写入以下路径,不进版本库
examples/hello-agent/memory.db
examples/hello-agent/memory_vectors.json
examples/hello-agent/traces/
examples/hello-agent/reports/
examples/hello-agent/evals/report-*.jsonl

# --- 备份区(本地重组产物,不进版本库) ---
_backup/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 日志 ---
*.log
