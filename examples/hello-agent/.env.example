# 复制本文件为 .env 后填写真实值

# ============================================================
# OpenAI / Ollama OpenAI-compatible
# ============================================================
OPENAI_API_KEY=sk-your-key-here

# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选:模型名,默认 gpt-4.1-mini
# AGENT_MODEL=gpt-4.1-mini

# 可选:最大 ReAct 步数,防死循环,默认 10
# AGENT_MAX_STEPS=10


# ============================================================
# Step 4 — 工具走 MCP Server(默认关)
# ============================================================
# AGENT_USE_MCP=1


# ============================================================
# Step 5 — 记忆(默认关)
# ============================================================
# AGENT_USE_MEMORY=1
# AGENT_SESSION=my-session-id        # 不填则每次随机
# EMBED_MODEL=nomic-embed-text:latest



# ============================================================
# Step 7 — Guardrails(默认:危险工具非交互模式拒绝)
# ============================================================
# AGENT_AUTO_APPROVE=1        # 危险工具自动放行(慎用!)
# AGENT_DENY_DANGEROUS=1      # 强制拒绝所有危险工具
# MAX_TOTAL_TOKENS=10000      # 总 token 上限
# MAX_COST_USD=0.50           # 总成本上限(USD)
# PRICE_PROMPT_USD_PER_1M=0.15
# PRICE_COMPLETION_USD_PER_1M=0.6


# ============================================================
# Step 8 — Trace(默认关)
# ============================================================
# AGENT_USE_TRACE=1

# HTTP body 截断长度(防止 trace 文件太大)
# TRACE_MAX_BODY_CHARS=4000

# 可选 Langfuse(留空则只写 JSONL)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com


# ============================================================
# HTTP 代理(可选;企业网/受限网络出公网时需要)
# ============================================================
# httpx 默认 trust_env=True,会自动 pick up 这些标准环境变量。
# NO_PROXY 必须包含内网 LLM/embedding 主机,否则会被错误地路由到代理。

